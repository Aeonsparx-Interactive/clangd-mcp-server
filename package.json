{
  "name": "@aeonsparx/clangd-mcp-server",
  "version": "0.1.0",
  "description": "MCP server that bridges Claude Code with clangd LSP for enhanced C++ code intelligence",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "clangd-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeonsparx-Interactive/clangd-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/Aeonsparx-Interactive/clangd-mcp-server/issues"
  },
  "homepage": "https://github.com/Aeonsparx-Interactive/clangd-mcp-server#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prepare": "npm run build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/e2e"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "clangd",
    "lsp",
    "language-server",
    "c++",
    "code-intelligence"
  ],
  "author": "Aeonsparx Interactive",
  "license": "MPL-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/node": "^24.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
